pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        // ── Image versioning (Sprint 3) ─────────────────────────────────────
        // IMAGE_TAG  = <git-sha-court>-<build-number>  → tracabilite exacte
        // IMAGE_NAME = tag versionne — utilise pour le push et le rollout
        // IMAGE_LATEST = alias :latest — mis a jour a chaque build main/develop
        IMAGE_BASE   = 'zakariael3/interntrackai-backend'
        SONAR_SERVER = 'sonarqube-local'
        SONAR_PROJECT_KEY = 'interntrackai-backend'
        SONAR_PROJECT_NAME = 'InternTrackAI Backend'
        K8S_NAMESPACE = 'staging'
        DOCKERFILE_PATH = 'docker/Dockerfile.backend'
        TRIVY_VERSION = '0.69.3'
        // NVD API key stockée dans Jenkins Credentials (type Secret text, id: nvd-api-key)
        // Sans cette clé : rate-limit NVD = 1 req/10s → timeouts fréquents
        NVD_API_KEY = credentials('nvd-api-key')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    // Calcul du tag versionné après checkout (GIT_COMMIT disponible)
                    def shortSha = sh(script: "git rev-parse --short=8 HEAD", returnStdout: true).trim()
                    env.IMAGE_TAG    = "${shortSha}-${BUILD_NUMBER}"
                    env.IMAGE_NAME   = "${IMAGE_BASE}:${env.IMAGE_TAG}"
                    env.IMAGE_LATEST = "${IMAGE_BASE}:latest"
                    echo "Image versionnee : ${env.IMAGE_NAME}"
                }
            }
        }

        stage('Build') {
            steps {
                sh '''
                echo "Construction du projet..."
                chmod +x mvnw || true
                if [ -f mvnw ]; then
                  ./mvnw -B -DskipTests clean compile
                else
                  mvn -B -DskipTests clean compile
                fi
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                echo "Execution des tests..."
                chmod +x mvnw || true
                if [ -f mvnw ]; then
                  ./mvnw -B test
                else
                  mvn -B test
                fi
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Scan') {
            steps {
                withSonarQubeEnv("${SONAR_SERVER}") {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                        echo "Analyse SonarQube..."
                        chmod +x mvnw || true
                        # sonar.coverage.exclusions : exclut config/entity/dto/exception/seed (pas de logique testable)
                        # sonar.cpd.exclusions : exclut dto/entity des détections de duplication (Lombok @Data)
                        SONAR_EXCLUSIONS="**/config/**,**/entity/**,**/dto/**,**/exception/**,**/seed/**,**/InternshipPlatformApplication.java"
                        MVN_CMD="mvn"
                        [ -f mvnw ] && MVN_CMD="./mvnw"
                        $MVN_CMD -B verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.projectKey=$SONAR_PROJECT_KEY \
                          -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                          -Dsonar.token=$SONAR_TOKEN \
                          -Dsonar.coverage.exclusions="$SONAR_EXCLUSIONS" \
                          -Dsonar.cpd.exclusions="**/dto/**,**/entity/**"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Security Tests Auto') {
            steps {
                // catchError garantit que le build reste UNSTABLE (jamais FAILURE) si OWASP détecte des CVEs
                // ou si le téléchargement NVD échoue — la pipeline continue vers Docker Build
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    // 30 min : nécessaire car NVD peut prendre 15-20 min à télécharger/mettre à jour
                    timeout(time: 30, unit: 'MINUTES') {
                        sh '''
                        echo "Analyse OWASP Dependency-Check (NVD API key configuree)..."
                        chmod +x mvnw || true
                        MVN_CMD="mvn"
                        [ -f mvnw ] && MVN_CMD="./mvnw"

                        $MVN_CMD -B org.owasp:dependency-check-maven:check \
                          -Dformat=ALL \
                          -DnvdApiKey=$NVD_API_KEY \
                          -DnvdApiDelay=2000 \
                          -DfailBuildOnCVSS=7 \
                          -DsuppressionFile=devsecops/owasp-suppressions.xml \
                          -DretireJsAnalyzerEnabled=false \
                          -DnodeAnalyzerEnabled=false
                        '''
                    }
                }
            }
            post {
                always {
                    // Archiver HTML + JSON + XML générés par -Dformat=ALL
                    archiveArtifacts allowEmptyArchive: true,
                        artifacts: '**/target/dependency-check-report.*,**/target/dependency-check-report/**'
                    // Publier le rapport HTML directement dans l'UI Jenkins si le plugin est installé
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency Check'
                    ])
                }
            }
        }

        stage('Semgrep Scan') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                    echo "Analyse Semgrep (regles custom DevSecOps)..."
                    docker run --rm \
                      -v "$(pwd):/src" \
                      returntocorp/semgrep:latest semgrep \
                      --config /src/devsecops/semgrep-rules.yml \
                      --json \
                      --output /src/semgrep-report.json \
                      /src/src || true
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'semgrep-report.json'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                echo "Build image Docker : $IMAGE_NAME"
                docker pull eclipse-temurin:17-jdk-alpine || true
                docker build --no-cache \
                  -t $IMAGE_NAME \
                  -t $IMAGE_LATEST \
                  --label "git.commit=$IMAGE_TAG" \
                  --label "build.number=$BUILD_NUMBER" \
                  -f $DOCKERFILE_PATH .
                '''
            }
        }

        stage('Image Security Scan') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                    set -o pipefail
                    echo "Scan Trivy de l'image Docker..."
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy:$TRIVY_VERSION image \
                      --severity HIGH,CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      $IMAGE_NAME | tee trivy-image-report.txt
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'trivy-image-report.txt'
                }
            }
        }

        stage('SBOM Generation') {
            // Sprint 3 : génération du Software Bill of Materials (CycloneDX)
            // Permet de tracer la composition exacte de l'image livrée
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh '''
                    echo "Generation SBOM (CycloneDX) pour $IMAGE_NAME..."
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy:$TRIVY_VERSION image \
                      --format cyclonedx \
                      --output /dev/stdout \
                      $IMAGE_NAME > sbom-cyclonedx.json
                    echo "SBOM genere : $(wc -l < sbom-cyclonedx.json) lignes"
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'sbom-cyclonedx.json'
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                    echo "Push image DockerHub : $IMAGE_NAME et $IMAGE_LATEST"
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    docker push $IMAGE_NAME    # tag versionne (git-sha-build)
                    docker push $IMAGE_LATEST  # alias :latest
                    echo "Images pushees avec succes"
                    '''
                }
            }
        }

        stage('Deploy Staging') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-staging', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                    echo "Deploiement Kubernetes sur staging..."
                    export KUBECONFIG=$KUBECONFIG_FILE

                    kubectl get ns $K8S_NAMESPACE || kubectl create ns $K8S_NAMESPACE

                    kubectl apply -f k8s/limitrange.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/networkpolicy.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/configmap.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/serviceaccount.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/postgres-pvc.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/postgres.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/deployment.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/service.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/ingress.yaml -n $K8S_NAMESPACE
                    # MinIO desactive : backend n'utilise pas encore S3 (io.minio absent du pom.xml)
                    # kubectl apply -f k8s/minio.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/prometheus.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/fluentbit.yaml -n $K8S_NAMESPACE
                    kubectl apply -f k8s/hpa.yaml -n $K8S_NAMESPACE

                    # Deploy avec image versionnee (Sprint 3 : plus de :latest en deploy)
                    kubectl set image deployment/interntrackai-backend backend=$IMAGE_NAME -n $K8S_NAMESPACE

                    kubectl rollout status deployment/postgres -n $K8S_NAMESPACE --timeout=180s
                    kubectl rollout status deployment/interntrackai-backend -n $K8S_NAMESPACE --timeout=180s
                    # kubectl rollout status deployment/minio -n $K8S_NAMESPACE --timeout=120s
                    kubectl rollout status deployment/prometheus -n $K8S_NAMESPACE --timeout=120s

                    kubectl get pods -n $K8S_NAMESPACE
                    kubectl get svc -n $K8S_NAMESPACE
                    '''
                }
            }
        }

        stage('Smoke Tests') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-staging', variable: 'KUBECONFIG_FILE')]) {
                    sh '''
                    echo "Smoke tests staging..."
                    export KUBECONFIG=$KUBECONFIG_FILE

                    BACKEND_IP=$(kubectl get svc interntrackai-backend-service \
                      -n $K8S_NAMESPACE -o jsonpath='{.spec.clusterIP}')

                    kubectl run smoke-health --image=curlimages/curl:8.5.0 \
                      --restart=Never --rm -i -n $K8S_NAMESPACE \
                      -- curl -sf --max-time 10 \
                      http://${BACKEND_IP}:8080/api/actuator/health | grep -q "UP"
                    echo "✓ /api/actuator/health = UP"

                    kubectl run smoke-api --image=curlimages/curl:8.5.0 \
                      --restart=Never --rm -i -n $K8S_NAMESPACE \
                      -- curl -sf --max-time 10 \
                      http://${BACKEND_IP}:8080/api/v3/api-docs | grep -q "openapi"
                    echo "✓ /api/v3/api-docs = OK"
                    '''
                }
            }
        }

        stage('Load Test (k6 smoke)') {
            // Sprint 5 : test de charge minimal (10 VU / 30s) via k6
            // Seuils : error_rate < 5%, P95 health < 2s
            // Résultat JSON archivé comme artefact Jenkins
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    withCredentials([file(credentialsId: 'kubeconfig-staging', variable: 'KUBECONFIG_FILE')]) {
                        sh '''
                        export KUBECONFIG=$KUBECONFIG_FILE
                        BACKEND_IP=$(kubectl get svc interntrackai-backend-service \
                          -n $K8S_NAMESPACE -o jsonpath='{.spec.clusterIP}')
                        echo "k6 smoke test sur http://${BACKEND_IP}:8080..."
                        docker run --rm \
                          -v "$(pwd):/src" \
                          --network host \
                          grafana/k6:0.51.0 run /src/devsecops/k6-smoke.js \
                          -e BASE_URL=http://${BACKEND_IP}:8080 \
                          --out json=/src/k6-smoke-report.json || true
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'k6-smoke-report.json'
                }
            }
        }

        stage('DAST — OWASP ZAP Baseline') {
            // Sprint 5 : scan DAST de surface (baseline) via OWASP ZAP
            // Mode baseline : ne teste pas les endpoints authentifiés
            // Résultat HTML + JSON archivés comme artefacts Jenkins
            // catchError : le build reste UNSTABLE (jamais FAILURE) si ZAP trouve des alertes
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    withCredentials([file(credentialsId: 'kubeconfig-staging', variable: 'KUBECONFIG_FILE')]) {
                        sh '''
                        export KUBECONFIG=$KUBECONFIG_FILE
                        BACKEND_IP=$(kubectl get svc interntrackai-backend-service \
                          -n $K8S_NAMESPACE -o jsonpath='{.spec.clusterIP}')
                        TARGET_URL="http://${BACKEND_IP}:8080/api"

                        echo "DAST ZAP Baseline sur $TARGET_URL..."
                        mkdir -p zap-reports
                        docker run --rm \
                          --network host \
                          -v "$(pwd)/zap-reports:/zap/wrk:rw" \
                          ghcr.io/zaproxy/zaproxy:stable \
                          zap-baseline.py \
                          -t $TARGET_URL \
                          -r zap-baseline-report.html \
                          -J zap-baseline-report.json \
                          -l WARN \
                          -I || true
                        '''
                    }
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true,
                        artifacts: 'zap-reports/zap-baseline-report.*'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'zap-reports',
                        reportFiles: 'zap-baseline-report.html',
                        reportName: 'OWASP ZAP DAST Report'
                    ])
                }
            }
        }

        stage('Report') {
            steps {
                echo 'Generation du rapport...'
                script {
                    // Résumé lisible dans la console Jenkins
                    echo """
╔══════════════════════════════════════════════════════════╗
║  InternTrackAI — Rapport de pipeline                     ║
╠══════════════════════════════════════════════════════════╣
║  Build        : #${BUILD_NUMBER}                         ║
║  Image        : ${env.IMAGE_NAME ?: IMAGE_BASE + ':latest'}  ║
║  Namespace    : ${K8S_NAMESPACE}                         ║
║  Statut       : ${currentBuild.currentResult}            ║
╚══════════════════════════════════════════════════════════╝
"""
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline executee avec succes.'
        }
        unstable {
            echo 'Pipeline terminee avec avertissements (OWASP/Trivy/Semgrep — voir artefacts).'
        }
        failure {
            // Sprint 4 : notification Teams Webhook sur echec
            // Prérequis Jenkins : credential de type Secret text, id = teams-webhook-url
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                withCredentials([string(credentialsId: 'teams-webhook-url', variable: 'TEAMS_URL')]) {
                    sh '''
                    PAYLOAD="{
                      \\"@type\\": \\"MessageCard\\",
                      \\"@context\\": \\"http://schema.org/extensions\\",
                      \\"themeColor\\": \\"FF0000\\",
                      \\"summary\\": \\"Pipeline FAILED\\",
                      \\"sections\\": [{
                        \\"activityTitle\\": \\"Pipeline InternTrackAI ECHOUEE\\",
                        \\"activityText\\": \\"Build #${BUILD_NUMBER} — image ${IMAGE_NAME:-latest} — statut FAILURE\\",
                        \\"facts\\": [
                          {\\"name\\": \\"Branch\\", \\"value\\": \\"${GIT_BRANCH:-develop}\\"},
                          {\\"name\\": \\"Build\\", \\"value\\": \\"#${BUILD_NUMBER}\\"},
                          {\\"name\\": \\"Lien\\", \\"value\\": \\"${BUILD_URL}\\"}
                        ]
                      }]
                    }"
                    curl -sf -X POST -H "Content-Type: application/json" \
                      -d "$PAYLOAD" "$TEAMS_URL" || true
                    '''
                }
            }
        }
        always {
            sh 'docker logout || true'
        }
    }
}