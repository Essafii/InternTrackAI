<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fichier de suppressions OWASP Dependency-Check — InternTrackAI
  ───────────────────────────────────────────────────────────────
  Règles d'ajout :
  1. La CVE doit être évaluée et documentée (raison + date de révision)
  2. Ne supprimer que si : faux positif prouvé OU feature inutilisée OU
     mitigation en place
  3. Revisiter toutes les suppressions trimestriellement
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      CVE-2023-34462 : Netty — TLS SNI mismatch (attaque man-in-the-middle)
      Statut : Faux positif — InternTrackAI n'expose pas de serveur Netty directement.
               Netty est une dépendance transitive de spring-boot-starter-web (Tomcat utilisé).
      Révisé : 2026-04-20
    -->
    <suppress>
        <notes>CVE-2023-34462 : Netty transitif via Spring Boot — Tomcat est le serveur effectif.
        Faux positif. Révisé 2026-04-20.</notes>
        <gav regex="true">^io\.netty:netty-.*:.*$</gav>
        <cve>CVE-2023-34462</cve>
    </suppress>

    <!--
      CVE-2022-1471 : SnakeYAML — désérialisation arbitraire
      Statut : Mitigé — spring.yaml.snakeyaml.enabled=true mais aucun YAML
               non maîtrisé n'est chargé au runtime. Entrées YAML limitées
               aux fichiers application.yml internes.
      Révisé : 2026-04-20
    -->
    <suppress>
        <notes>CVE-2022-1471 : SnakeYAML — uniquement utilisé pour charger application.yml
        interne. Pas d'input utilisateur YAML. Mitigé. Révisé 2026-04-20.</notes>
        <gav regex="true">^org\.yaml:snakeyaml:.*$</gav>
        <cve>CVE-2022-1471</cve>
    </suppress>

    <!--
      Suppressions Temporary — à traiter lors du prochain sprint
      (liste vide — aucune suppression temporaire en cours)
    -->

</suppressions>
